{
  "builds": [
    {
      "src": "server/node/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "server/node/server.js" }
  ],
  "functions": {
    "server/node/server.js": {
      "includeFiles": [
        "server/node/html/**",
        "server/node/css/**",
        "server/node/js/**"
      ]
    }
  ]
}
